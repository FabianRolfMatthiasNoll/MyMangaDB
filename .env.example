# API Security
# Secret used to sign the session tokens (JWT). Generate one with:
#   openssl rand -hex 32
# The backend refuses to start when it is set to a publicly known value.
API_TOKEN=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Database and Image paths
DATABASE_PATH=./data/manga.db
IMAGE_PATH=./data/images

# SSL Verification (Set to true to disable SSL verification)
DISABLE_SSL_VERIFY=true
